rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/settings/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && docId == "improve"
        && request.resource.data.keys().hasOnly(["text", "updatedAt"])
        && request.resource.data.text is string
        && request.resource.data.text.size() < 12000
        && request.resource.data.updatedAt is number;
    }
    match /users/{userId}/conversations/{conversationId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["title", "messages", "createdAt", "updatedAt"])
        && request.resource.data.title is string
        && request.resource.data.title.size() < 200
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && request.resource.data.messages is list
        && request.resource.data.messages.size() < 200;
    }
  }
}
